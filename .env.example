# Example environment file for local development
# To enable Docker SQL Server for development, copy this to .env and set USE_DOCKER_DB=1
# and ensure a SQL container is running and accessible.

# Example DOCKER_DB_CONNECTION (Azure SQL Edge / SQL Server):
# DOCKER_DB_CONNECTION="Server=127.0.0.1,1433;Database=sandwich_app;User Id=sa;Password=MyStrongPass123;TrustServerCertificate=True;"

# To opt-in to the Docker DB when starting dev servers:
# USE_DOCKER_DB=1 ./dev-start-all.sh

# By default the project uses a local SQLite fallback so contributors can run
# the app without Docker or SQL Server.
# Copy this to .env and update the password/host as needed
DOCKER_DB_CONNECTION='Server=127.0.0.1,1433;Database=sandwich_app;User Id=sa;Password=MyStrongPass123;TrustServerCertificate=True;'
